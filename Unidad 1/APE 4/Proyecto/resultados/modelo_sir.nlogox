<?xml version='1.0' encoding='UTF-8'?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [csv]

globals [
  datos-java
  tiempo-actual
  susceptibles-actual
  infectados-actual
  recuperados-actual
  indice-actual
]

to cargar-java
  let archivo user-file

  if archivo = false [
    stop
  ]

  let filas csv:from-file archivo
  set datos-java but-first filas

  set indice-actual 0
  clear-all-plots
  mostrar-registro first datos-java

  print (word "Registros cargados: " length datos-java)
end


to mostrar-registro [registro]
  set tiempo-actual item 0 registro
  set susceptibles-actual item 1 registro
  set infectados-actual item 2 registro
  set recuperados-actual item 3 registro

  dibujar-poblacion

  ;; Ejecutar las instrucciones de los tres trazos.
  update-plots
end


to dibujar-poblacion
  clear-turtles

  ;; Fondo oscuro para destacar las figuras.
  ask patches [
    set pcolor [22 26 33]
  ]

  let total susceptibles-actual
            + infectados-actual
            + recuperados-actual

  create-turtles total [
    set shape "person"
    set heading 0

    ;; Distribuir las personas en diez columnas.
    let columna who mod 10
    let fila floor (who / 10)

    let ancho-celda world-width / 10
    let alto-celda world-height / 10

    setxy
      (min-pxcor - 0.5 + (columna + 0.5) * ancho-celda)
      (max-pycor + 0.5 - (fila + 0.5) * alto-celda)

    set size (0.75 * min (list ancho-celda alto-celda))

    ;; Asignar los colores según los conteos.
    ifelse who < susceptibles-actual [
      set color [65 155 255]
    ] [
      ifelse who < (susceptibles-actual + infectados-actual) [
        set color [245 85 95]
      ] [
        set color [65 205 145]
      ]
    ]
  ]
end


to avanzar
  ;; Comprobar que se haya cargado un archivo.
  if not is-list? datos-java [
    user-message "Primero pulsa Cargar CSV."
    stop
  ]

  if empty? datos-java [
    user-message "El archivo no contiene registros."
    stop
  ]

  ;; Al llegar al último registro, no avanzar más.
  if indice-actual >= (length datos-java - 1) [
    stop
  ]

  set indice-actual indice-actual + 1

  mostrar-registro (item indice-actual datos-java)
end


to reproducir
  if not is-list? datos-java [
    user-message "Primero pulsa Cargar CSV."
    stop
  ]

  if empty? datos-java [
    stop
  ]

  ;; Detener la reproducción al terminar los datos.
  if indice-actual >= (length datos-java - 1) [
    stop
  ]

  avanzar

  ;; Mostrar el cambio y esperar antes del siguiente paso.
  display
  wait 0.15
end


to reiniciar
  if not is-list? datos-java [
    user-message "Primero pulsa Cargar CSV."
    stop
  ]

  if empty? datos-java [
    stop
  ]

  set indice-actual 0
  clear-all-plots
  mostrar-registro first datos-java
end]]></code>
  <widgets>
    <view x="240" wrappingAllowedX="true" y="185" frameRate="30.0" minPycor="-16" height="401" showTickCounter="false" patchSize="12.0" fontSize="10" wrappingAllowedY="true" width="401" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"/>
    <button x="20" y="140" height="42" disableUntilTicks="false" forever="false" kind="Observer" width="180" display="Cargar CSV">cargar-java</button>
    <button x="20" y="250" height="42" disableUntilTicks="false" forever="false" kind="Observer" width="180" display="Avanzar un paso">avanzar</button>
    <monitor x="240" precision="0" y="85" height="65" fontSize="20" width="260" display="Susceptibles (S)">susceptibles-actual</monitor>
    <monitor x="520" precision="0" y="85" height="65" fontSize="20" width="260" display="Infectados (I)">infectados-actual</monitor>
    <monitor x="800" precision="0" y="85" height="65" fontSize="20" width="260" display="Recuperados (R)">recuperados-actual</monitor>
    <monitor x="1080" precision="0" y="85" height="65" fontSize="20" width="260" display="Tiempo / 100">tiempo-actual</monitor>
    <button x="20" y="195" height="42" disableUntilTicks="false" forever="true" kind="Observer" width="180" display="Reproducir / Pausar">reproducir</button>
    <button x="20" y="305" height="42" disableUntilTicks="false" forever="false" kind="Observer" width="180" display="Reiniciar">reiniciar</button>
    <plot x="675" autoPlotX="false" yMax="100.0" autoPlotY="false" yAxis="Personas" y="185" xMin="0.0" height="401" legend="true" xMax="100.0" yMin="0.0" width="665" xAxis="Tiempo" display="Evolución SIR">
      <setup/>
      <update/>
      <pen interval="1.0" mode="0" display="Susceptibles" color="-12477441" legend="true">
        <setup/>
        <update>set-plot-pen-color [65 155 255]
plotxy tiempo-actual susceptibles-actual</update>
      </pen>
      <pen interval="1.0" mode="0" display="Infectados" color="-699041" legend="true">
        <setup/>
        <update>set-plot-pen-color [245 85 95]
plotxy tiempo-actual infectados-actual</update>
      </pen>
      <pen interval="1.0" mode="0" display="Recuperados" color="-12464751" legend="true">
        <setup/>
        <update>set-plot-pen-color [65 205 145]
plotxy tiempo-actual recuperados-actual</update>
      </pen>
    </plot>
  <note x="20" y="8" width="600" height="38" fontSize="26" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-1314054" textColorLight="-15128516">MODELO SIR</note><note x="20" y="49" width="1100" height="25" fontSize="13" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-6705725" textColorLight="-15128516">Evolución epidemiológica  |  Resultados de Java visualizados en NetLogo</note><note x="1120" y="22" width="225" height="28" fontSize="12" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-12477441" textColorLight="-15128516">APE 4  /  SIMULACIÓN</note><note x="20" y="100" width="180" height="26" fontSize="13" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-6705725" textColorLight="-15128516">CONTROLES</note><note x="240" y="157" width="401" height="26" fontSize="13" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-6705725" textColorLight="-15128516">POBLACIÓN · 100 PERSONAS</note><note x="675" y="157" width="665" height="26" fontSize="13" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-6705725" textColorLight="-15128516">EVOLUCIÓN EN EL TIEMPO</note><note x="20" y="383" width="190" height="25" fontSize="11" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-6705725" textColorLight="-15128516">DATOS DEL EXPERIMENTO</note><note x="20" y="414" width="190" height="80" fontSize="12" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-1972241" textColorLight="-15128516">Población: 100
β = 0.30   ·   γ = 0.10
Tiempo: 0 a 100</note><note x="20" y="511" width="195" height="70" fontSize="11" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-6705725" textColorLight="-15128516">Carga el CSV, reproduce
y pulsa otra vez para pausar.
Pausa antes de reiniciar.</note><note x="240" y="598" width="1100" height="25" fontSize="12" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-6705725" textColorLight="-15128516">Azul: susceptibles   ·   Rojo: infectados   ·   Verde: recuperados</note><note x="240" y="626" width="1100" height="24" fontSize="11" markdown="false" backgroundDark="0" backgroundLight="0" textColorDark="-6705725" textColorLight="-15128516">Cada figura representa una persona del conteo; el CSV no registra identidades ni posiciones.</note></widgets>
